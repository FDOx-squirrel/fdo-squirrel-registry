    fdo:acquisitionMethod "Photogrammetry (structure from motion)" ;
    fdo:context "Early medieval sarcophagus from Govan Old (Govan Old Parish Church, Govan Road, Glasgow), rediscovered in the churchyard by a gravedigger in the mid-1850s (sources give 1855 and 1856); now displayed in the Govan Stones museum in the church. Numbered Govan 1 in the collection. The only sarcophagus of its kind recorded from pre-Norman northern Britain." ;
    fdo:documentationPurpose "Digital documentation of the Govan Stones for the analysis of early medieval sculpture (Kasten, PhD thesis, University of Glasgow, 2019)." .

ns02:zenodo.24346337 a crm:E73_Information_Object,
        crmdig:D1_Digital_Object,
        dcat:Dataset,
        fdo:3DDataFDO ;
    rdfs:label "Zenodo concept DOI" ;
    dct:created "2021-01-08"^^xsd:date ;
    dct:creator ns06:0000-0002-3246-3531,
        ns06:0000-0003-1011-7539,
        ns11:17d069bc937de195 ;
    dct:description "3D model of Govan 2 (Stirling Maxwell and ECMS numbering; Lang 1), one of the five hogback grave monuments of Govan Old Parish Church in Glasgow. At about two metres in length it is the smallest of the five and the best preserved, and it is dated to the early 10th century. Above two rows of tegulation (roof-shingle carving) the 3D analysis shows what appears to be a row of step pattern along the worn ridge. The model was recorded by structure-from-motion photogrammetry as part of Megan N. Kasten's PhD research on the Govan Stones (University of Glasgow, 2019) and was published on Sketchfab by the Govan Stones account under CC BY 4.0." ;
    dct:identifier ns02:zenodo.24346337 ;
    dct:issued "2021-01-08"^^xsd:date ;
    dct:license <http://creativecommons.org/licenses/by/4.0/>,
