fdoreg:catalog a crm:E31_Document,
        dcat:Catalog ;
    dct:conformsTo <https://w3id.org/fdo-squirrel/crm/> ;
    dct:description "A catalogue of FAIR Digital Objects published with fdo-squirrel. Each record points at one pinned Zenodo version; the metadata is harvested from the package itself and anchored in CIDOC CRM through the bridge at https://w3id.org/fdo-squirrel/crm/."@en ;
    dct:issued "2026-09-03"^^xsd:date ;
    dct:license ns011:CC-BY-4.0.html ;
    dct:publisher wd:Q73901970 ;
    dct:title "FDOx Registry"@en ;
    crm:P102_has_title "FDOx Registry"@en ;
    crm:P3_has_note "A catalogue of FAIR Digital Objects published with fdo-squirrel. Each record points at one pinned Zenodo version; the metadata is harvested from the package itself and anchored in CIDOC CRM through the bridge at https://w3id.org/fdo-squirrel/crm/."@en ;
    dcat:dataset ns02:zenodo.18369125,
        ns02:zenodo.18369156,
        ns02:zenodo.18369720,
        ns02:zenodo.18369865,
        ns02:zenodo.18724635,
        ns02:zenodo.18732892,
        ns02:zenodo.18742693,
        ns02:zenodo.22676379,
        ns02:zenodo.24285298,
        ns02:zenodo.24305240,
        ns02:zenodo.24305343,
        ns02:zenodo.24305428,
        ns02:zenodo.24305436,
        ns02:zenodo.24346313,
        ns02:zenodo.24346337 ;
    dcat:record ns12:18369126,
        ns12:18369157,
        ns12:18369866,
        ns12:18732893,
        ns12:18742694,
        ns12:18744583,
        ns12:22676380,
        ns12:24285299,
