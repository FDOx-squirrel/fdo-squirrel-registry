    fdo:acquisitionImagesCount "93" ;
    fdo:acquisitionMethod "Photogrammetry (structure from motion) with KIRI Engine" ;
    fdo:context "Found around 1851 in the ringfort at Garranes (SMR CO084-090001-), probably in its souterrain (SMR CO084-090002-); the findspot is recorded as SMR CO084-090003-. Probably acquired for the UCC collection in or around 1907. Now on permanent display in the Stone Corridor of University College Cork, Cork City (SMR CO074-148----, 51.8937, -8.4924), which is the present location, not the findspot. Described in OG(H)AM entry I-COR-030." ;
    fdo:documentationPurpose "3D documentation of an ogham stone in the UCC collection (Ogham in 3D)." ;
    fdo:overallCondition "An irregularly shaped pillar, seemingly reused in a souterrain and damaged in places, particularly along the vulnerable edges; 1.57 m of the 1.75 m reported by Macalister are accessible today. Conserved with the other UCC ogham stones in 2006; displayed in a case and held in position by brackets (OG(H)AM I-COR-030)." .

ns02:zenodo.24285298 a crm:E73_Information_Object,
        crmdig:D1_Digital_Object,
        dcat:Dataset,
        fdo:3DDataFDO ;
    rdfs:label "Zenodo concept DOI" ;
    dct:created "2025-06-12"^^xsd:date ;
    dct:creator ns06:0000-0002-3246-3531,
        ns11:1ef85dc7cadee6db ;
    dct:description "3D model of the ogham stone from Gowran (Gabhrán), Co. Kilkenny, Ireland (CIIC 32; CISP GOWRN/1; SMR KK020-060007-), a grit pillar stone inscribed in Primitive Irish. It was found in the foundations of the chancel of the medieval parish church of St Mary's, Gowran, when the chancel was demolished in 1827, and is now displayed on site in the rebuilt chancel. The model was made with KIRI Engine from 111 photographs; the uploader notes that the scan is imperfect because of poor lighting on site." ;
    dct:identifier ns02:zenodo.24285298 ;
    dct:issued "2025-06-12"^^xsd:date ;
    dct:license <http://creativecommons.org/licenses/by/4.0/>,
        ns011:CC-BY-4.0.html ;
    dct:provenance "Scan quality is limited by poor lighting at the site (uploader's note); published on Sketchfab. For this FDO the model was re-oriented in Blender (180 degrees about the horizontal axis towards the preview camera, i.e. Euler XYZ 180,0,-90) so that the stone stands upright; the Sketchfab original is unchanged." ;
    dct:publisher wd:Q73901970 ;
    dct:relation wd:Q70892361,
        ns05:I-KIK-007.xml,
        ns07:gowran-ogham-stone-ffc2e644be634a19990cecb1ca857e42,
