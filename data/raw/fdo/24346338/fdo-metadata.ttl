<https://doi.org/10.5281/zenodo.24346337> a dcat:Dataset, crmdig:D1_Digital_Object, crm:E73_Information_Object, fdo:3DDataFDO ;
    prov:wasGeneratedBy <urn:fdo-squirrel:activity/build> ;
    dct:description "3D model of Govan 2 (Stirling Maxwell and ECMS numbering; Lang 1), one of the five hogback grave monuments of Govan Old Parish Church in Glasgow. At about two metres in length it is the smallest of the five and the best preserved, and it is dated to the early 10th century. Above two rows of tegulation (roof-shingle carving) the 3D analysis shows what appears to be a row of step pattern along the worn ridge. The model was recorded by structure-from-motion photogrammetry as part of Megan N. Kasten's PhD research on the Govan Stones (University of Glasgow, 2019) and was published on Sketchfab by the Govan Stones account under CC BY 4.0." ;
    dct:creator <https://orcid.org/0000-0003-1011-7539> ;
    dct:creator <urn:fdo-squirrel:person/17d069bc937de195> ;
    dct:creator <https://orcid.org/0000-0002-3246-3531> ;
    dct:license <http://creativecommons.org/licenses/by/4.0/> ;
    dct:publisher <http://www.wikidata.org/entity/Q73901970> ;
    dct:title "Govan 2 Hogback (Govan Stones)" ;
