<https://doi.org/10.5281/zenodo.24305343> a dcat:Dataset, crmdig:D1_Digital_Object, crm:E73_Information_Object, fdo:3DDataFDO ;
    prov:wasGeneratedBy <urn:fdo-squirrel:activity/build> ;
    dct:description "Idealised reconstruction of a white stepped LEGO pyramid (nine levels) with a five-brick column and a minifigure-style warrior figure on top (spiked helmet, mail shirt, tunic, cloak), a hobby build by Florian Thiery, rebuilt procedurally from clean LEGO bricks after a KIRI Engine scan. Only dimensions and structure were read from the scan; no scan mesh or texture was reused. AI disclosure: the reconstruction was generated with Claude (Anthropic, claude-sonnet-5-5) on behalf of Florian Thiery. It is an interpretation model, not a measurement." ;
    dct:creator <https://orcid.org/0000-0002-3246-3531> ;
    dct:license <http://creativecommons.org/licenses/by/4.0/> ;
    dct:publisher <http://www.wikidata.org/entity/Q73901970> ;
    dct:title "Lego Pyramid (Reconstruction claude.ai)" ;
    dcat:distribution <urn:fdo-squirrel:dist/14af52e4a67ec778>,<urn:fdo-squirrel:dist/3958aebd7ed81c14>,<urn:fdo-squirrel:dist/0eb0fe6f0c9babd2>,<urn:fdo-squirrel:dist/819a447bd417a4d2>,<urn:fdo-squirrel:dist/aee528ec8e695818>,<urn:fdo-squirrel:dist/296bc25ba60aee91>,<urn:fdo-squirrel:dist/ece181cdecde621a>,<urn:fdo-squirrel:dist/1ffec1e1e34fdfb1>,<urn:fdo-squirrel:dist/852f5acd09713fe8>,<urn:fdo-squirrel:dist/5782d58d11437c0f>,<urn:fdo-squirrel:dist/04b54942c91c510e>,<urn:fdo-squirrel:dist/0e623d3c26743f35>,<urn:fdo-squirrel:dist/6132a60724847178>,<urn:fdo-squirrel:dist/f7f6a5894f1d19dd>,<urn:fdo-squirrel:dist/012d3ae0f6007283>,<urn:fdo-squirrel:dist/4ceb643e8b6d7cd2>,<urn:fdo-squirrel:dist/b4416be937053d8a>,<urn:fdo-squirrel:dist/f6e15e9e5f49e3de>,<urn:fdo-squirrel:dist/fe753c2685ec886c>,<urn:fdo-squirrel:dist/cf14dd446fc3537f>,<urn:fdo-squirrel:dist/5ed91bb5c3d8a4b1>,<urn:fdo-squirrel:dist/50e62db9b10cc50c>,<urn:fdo-squirrel:dist/ada023eb80b0ce5c>,<urn:fdo-squirrel:dist/0b383d5a63da644f>,<urn:fdo-squirrel:dist/1a8195ca9d0812e7>,<urn:fdo-squirrel:dist/0e4d58088180effe>,<urn:fdo-squirrel:dist/3b2a44995e927286>,<urn:fdo-squirrel:dist/536c5576e2ee7561>,<urn:fdo-squirrel:dist/2ad4f592d31cf358>,<urn:fdo-squirrel:dist/9fd7be788d73ee57>,<urn:fdo-squirrel:dist/25108ed495e10582>,<urn:fdo-squirrel:dist/e221c116fce7a4fc>,<urn:fdo-squirrel:dist/ff48136f9eeca235> ;
    dct:created "2026-11-17"^^xsd:date ;
    dct:issued "2026-11-17"^^xsd:date ;
    dct:contributor _:contributors0_1 ;
    dcat:keyword "3D data" ;
    dct:subject <http://www.wikidata.org/entity/Q229370> ;
    dcat:keyword "Cultural Heritage" ;
    dct:subject <http://www.wikidata.org/entity/Q110840> ;
    dcat:keyword "lego" ;
    dcat:keyword "Architecture" ;
    dct:relation <https://sketchfab.com/3d-models/lego-pyramid-reconstruction-claudeai-e2fb31006245424e88033714af2c90f5> ;
    prov:wasDerivedFrom <https://sketchfab.com/3d-models/lego-pyramid-reconstruction-claudeai-e2fb31006245424e88033714af2c90f5> ;
    dct:relation <https://doi.org/10.5281/zenodo.24305240> ;
    prov:wasDerivedFrom <https://doi.org/10.5281/zenodo.24305240> ;
    fdo:context "Self-built (own design, no commercial set) by Florian Thiery. Shown at the Apothekertrakt of Schönbrunn Palace during CHNT31, 2026-11-12 (https://www.openstreetmap.org/relation/6892072). The figure on top is read as a medieval warrior; that and any further identification are open hypotheses, not confirmed." ;
    dct:type _:heritage_object_object_type0_1 ;
    fdo:documentationPurpose "Test case for FDOx packaging of a scan and its reconstruction." ;
    dct:provenance "{\"ai_involvement\": \"Generated with Claude (Anthropic, claude-sonnet-5-5), session 2026-11-12 to 2026-11-17\", \"figure\": \"Modelled from 11 photographs supplied by Florian Thiery, 32.3 mm tall, painted head and torso textures\", \"known_deviations\": \"Cloak, hands and sleeves paler than in the photos; mail shirt as honeycomb pattern; cheek guards flat; sleeves plain tubes\", \"method\": \"Procedural rebuild from idealised bricks (script build_lego3.py), not a cleaned scan mesh\", \"random_seed\": \"numpy.random.default_rng(11)\", \"reproducibility\": \"Re-running the script reproduces lego.glb byte-identically with Python 3.13.18, numpy 2.5.3, trimesh 5.2.1, Pillow 12.3.0, scipy 1.18.1 (sha256 cf51067881aef419856a403725c1352c7c7d14715f286018066991afbc1e9569)\", \"scale\": \"2/3 of real LEGO dimensions (8 mm grid, 9.6 mm brick height, 4.8 mm studs), fitted to the scan\", \"structure\": \"9 levels (14x18 down to 2x2 studs) plus a column of 5 1x1 bricks; 97x 2x4, 5x 2x2, 5x 1x1, all white\"}" ;
    codemeta:programmingLanguage "Python"  .

