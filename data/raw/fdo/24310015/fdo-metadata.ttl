<https://doi.org/10.5281/zenodo.24305428> a dcat:Dataset, crmdig:D1_Digital_Object, crm:E73_Information_Object, fdo:3DDataFDO ;
    prov:wasGeneratedBy <urn:fdo-squirrel:activity/build> ;
    dct:description "Photogrammetric 3D scan (KIRI Engine) of a stepped LEGO pyramid with four grey stair arms (seven levels) and a small temple with four corner pillars on top, a hobby build by Daria Stefan (TU Wien); scanned on 2026-11-12 in the Apothekertrakt of Schönbrunn Palace, Vienna, where the model was on display during the CHNT31 conference. Raw scan without clean-up. The paired reconstruction is a separate FDOx and derives from this one." ;
    dct:creator <https://orcid.org/0000-0002-3246-3531> ;
    dct:license <http://creativecommons.org/licenses/by/4.0/> ;
    dct:publisher <http://www.wikidata.org/entity/Q73901970> ;
    dct:title "Lego Pyramid Maya (KIRI Original)" ;
