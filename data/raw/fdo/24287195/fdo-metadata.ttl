<https://doi.org/10.5281/zenodo.18724635> a dcat:Dataset, crmdig:D1_Digital_Object, crm:E73_Information_Object, fdo:3DDataFDO ;
    prov:wasGeneratedBy <urn:fdo-squirrel:activity/build> ;
    dct:description "3D model of the ogham stone CIIC 81 (CISP GARES/1; University College Cork inv. no. 4), a green sandstone pillar inscribed in Primitive Irish with C[A]SSITT[A]S MAQI MU[CO]I CALLITI. It was unearthed around 1851 in the ringfort at Garranes (An Garrán), Co. Cork (SMR CO084-090003-), and is thought to have come from the souterrain there. Probably acquired for the UCC collection in or around 1907, it is now on permanent display in the Stone Corridor ('Rúin na gCloch / Stories in Stone') at University College Cork, Cork City (SMR CO074-148----)." ;
    dct:creator <urn:fdo-squirrel:person/1ef85dc7cadee6db> ;
    dct:creator <https://orcid.org/0000-0002-3246-3531> ;
    dct:license <http://creativecommons.org/licenses/by/4.0/> ;
    dct:publisher <http://www.wikidata.org/entity/Q73901970> ;
    dct:title "Cork Ogham Stone CIIC 81 (UCC 4)" ;
    dcat:distribution <urn:fdo-squirrel:dist/1f46c84a1060400a>,<urn:fdo-squirrel:dist/54f451839b59e2e6>,<urn:fdo-squirrel:dist/2727c14d34bdc2f5>,<urn:fdo-squirrel:dist/6c2c935cd95e8d0b>,<urn:fdo-squirrel:dist/6e194df47333d39f>,<urn:fdo-squirrel:dist/0cb6f6e4d080bd73>,<urn:fdo-squirrel:dist/c931d515da3c3c91>,<urn:fdo-squirrel:dist/4e5819fd779cac0d>,<urn:fdo-squirrel:dist/5782d58d11437c0f>,<urn:fdo-squirrel:dist/04b54942c91c510e>,<urn:fdo-squirrel:dist/0e623d3c26743f35>,<urn:fdo-squirrel:dist/6132a60724847178>,<urn:fdo-squirrel:dist/f7f6a5894f1d19dd>,<urn:fdo-squirrel:dist/012d3ae0f6007283>,<urn:fdo-squirrel:dist/4ceb643e8b6d7cd2>,<urn:fdo-squirrel:dist/b4416be937053d8a>,<urn:fdo-squirrel:dist/f6e15e9e5f49e3de>,<urn:fdo-squirrel:dist/fe753c2685ec886c>,<urn:fdo-squirrel:dist/cf14dd446fc3537f>,<urn:fdo-squirrel:dist/5ed91bb5c3d8a4b1>,<urn:fdo-squirrel:dist/50e62db9b10cc50c>,<urn:fdo-squirrel:dist/ada023eb80b0ce5c>,<urn:fdo-squirrel:dist/0b383d5a63da644f>,<urn:fdo-squirrel:dist/1a8195ca9d0812e7>,<urn:fdo-squirrel:dist/0e4d58088180effe>,<urn:fdo-squirrel:dist/3b2a44995e927286>,<urn:fdo-squirrel:dist/536c5576e2ee7561>,<urn:fdo-squirrel:dist/2ad4f592d31cf358>,<urn:fdo-squirrel:dist/9fd7be788d73ee57>,<urn:fdo-squirrel:dist/25108ed495e10582>,<urn:fdo-squirrel:dist/e221c116fce7a4fc>,<urn:fdo-squirrel:dist/ff48136f9eeca235> ;
