<https://doi.org/10.5281/zenodo.24305436> a dcat:Dataset, crmdig:D1_Digital_Object, crm:E73_Information_Object, fdo:3DDataFDO ;
    prov:wasGeneratedBy <urn:fdo-squirrel:activity/build> ;
    dct:description "Idealised reconstruction of a stepped LEGO pyramid with four grey stair arms (seven levels) and a small temple with four corner pillars on top, a hobby build by Daria Stefan (TU Wien), rebuilt procedurally from clean LEGO bricks after a KIRI Engine scan. Only dimensions and structure were read from the scan; no scan mesh or texture was reused. AI disclosure: the reconstruction was generated with Claude (Anthropic, claude-sonnet-5-5) on behalf of Florian Thiery. It is an interpretation model, not a measurement." ;
    dct:creator <https://orcid.org/0000-0002-3246-3531> ;
    dct:license <http://creativecommons.org/licenses/by/4.0/> ;
    dct:publisher <http://www.wikidata.org/entity/Q73901970> ;
    dct:title "Lego Pyramid Maya (Reconstruction claude.ai)" ;
    dcat:distribution <urn:fdo-squirrel:dist/ba6bcc594ccbfb0d>,<urn:fdo-squirrel:dist/420bd994873324c5>,<urn:fdo-squirrel:dist/ebc2e2602c51d0fa>,<urn:fdo-squirrel:dist/14502acb26f4e26c>,<urn:fdo-squirrel:dist/aeaa897829188453>,<urn:fdo-squirrel:dist/d44b4a1540b3fc6d>,<urn:fdo-squirrel:dist/bd277a503cb8e7e0>,<urn:fdo-squirrel:dist/5782d58d11437c0f>,<urn:fdo-squirrel:dist/04b54942c91c510e>,<urn:fdo-squirrel:dist/0e623d3c26743f35>,<urn:fdo-squirrel:dist/6132a60724847178>,<urn:fdo-squirrel:dist/f7f6a5894f1d19dd>,<urn:fdo-squirrel:dist/012d3ae0f6007283>,<urn:fdo-squirrel:dist/4ceb643e8b6d7cd2>,<urn:fdo-squirrel:dist/b4416be937053d8a>,<urn:fdo-squirrel:dist/f6e15e9e5f49e3de>,<urn:fdo-squirrel:dist/fe753c2685ec886c>,<urn:fdo-squirrel:dist/cf14dd446fc3537f>,<urn:fdo-squirrel:dist/5ed91bb5c3d8a4b1>,<urn:fdo-squirrel:dist/50e62db9b10cc50c>,<urn:fdo-squirrel:dist/ada023eb80b0ce5c>,<urn:fdo-squirrel:dist/0b383d5a63da644f>,<urn:fdo-squirrel:dist/1a8195ca9d0812e7>,<urn:fdo-squirrel:dist/0e4d58088180effe>,<urn:fdo-squirrel:dist/3b2a44995e927286>,<urn:fdo-squirrel:dist/536c5576e2ee7561>,<urn:fdo-squirrel:dist/2ad4f592d31cf358>,<urn:fdo-squirrel:dist/9fd7be788d73ee57>,<urn:fdo-squirrel:dist/25108ed495e10582>,<urn:fdo-squirrel:dist/e221c116fce7a4fc>,<urn:fdo-squirrel:dist/ff48136f9eeca235> ;
    dct:created "2026-11-17"^^xsd:date ;
    dct:issued "2026-11-17"^^xsd:date ;
    dct:contributor _:contributors0_1 ;
    dct:contributor <https://orcid.org/0009-0008-0586-9350> ;
    dcat:keyword "3D data" ;
    dct:subject <http://www.wikidata.org/entity/Q229370> ;
    dcat:keyword "Cultural Heritage" ;
    dct:subject <http://www.wikidata.org/entity/Q110840> ;
    dcat:keyword "pyramid" ;
    dcat:keyword "reconstruction" ;
    dcat:keyword "lego" ;
    dcat:keyword "Claude" ;
    dcat:keyword "maya" ;
    dcat:keyword "Architecture" ;
    dct:relation <https://sketchfab.com/3d-models/lego-pyramid-maya-reconstruction-claudeai-fe33b10adee4421fa3a06cc12f7d6c62> ;
    prov:wasDerivedFrom <https://sketchfab.com/3d-models/lego-pyramid-maya-reconstruction-claudeai-fe33b10adee4421fa3a06cc12f7d6c62> ;
    dct:relation <https://doi.org/10.5281/zenodo.24305428> ;
    prov:wasDerivedFrom <https://doi.org/10.5281/zenodo.24305428> ;
    fdo:context "Self-built (own design, no commercial set) by Daria Stefan (TU Wien). Shown at the Apothekertrakt of Schönbrunn Palace during CHNT31, 2026-11-12 (https://www.openstreetmap.org/relation/6892072). Identification as a Maya-style stepped pyramid with a temple was confirmed by the builder. A specific model such as El Castillo (Chichén Itzá) is NOT confirmed." ;
    dct:type _:heritage_object_object_type0_1 ;
    fdo:documentationPurpose "Test case for FDOx packaging of a scan and its reconstruction." ;
    dct:provenance "{\"ai_involvement\": \"Generated with Claude (Anthropic, claude-sonnet-5-5), session 2026-11-12 to 2026-11-17\", \"alignment\": \"Scan rotated by 16.25 degrees (sharpness histogram around the temple centre); grid and brick height derived from 4 million surface points (about 13 cells per stud)\", \"assumptions\": \"Seven levels after photo and builder statement (the scan suggests up to eight, the lowest probably merged with the table); pillar rotations 14, -12, 16, -9 degrees and block twist estimated by eye; stair arms on levels 6/7 symmetric in the model but not fully in the photo; scan ground plane not carried over\", \"bricks\": \"white 32x 2x4, 20x 2x2, 12x 1x1, 8 special 1x2/1x4; grey 70x 2x4, 9x 2x2\", \"colours_rgb\": \"white (245, 245, 241), grey (48, 50, 48)\", \"method\": \"Procedural rebuild from idealised bricks (script build_m3.py, version 4), not a cleaned scan mesh\", \"random_seed\": \"numpy.random.default_rng(5)\", \"reproducibility\": \"Re-running the script reproduces lego3.glb byte-identically with Python 3.13.18, numpy 2.5.3, trimesh 5.2.1, Pillow 12.3.0, scipy 1.18.1 (sha256 543a744f2ec29f9b65c12008cd01b3b2fe829ccf1eeef1bc74b40a27943eac8b)\", \"structure\": \"7 levels; four stair arms 4 studs wide reaching 9, 8, 7, 6, 5, 4, 3 studs from the centre; white corner areas 6x6 down to 2x2; temple of 4 layers with four white 1x1 corner pillars\"}" ;
    codemeta:programmingLanguage "Python"  .

